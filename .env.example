# VGS assistant - example configuration.
# Copy to .env (never commit .env). Every value comes from the environment.
# Empty values must be filled in before the matching feature is used.

# --- General ---------------------------------------------------------------
VGS_ENV=development                 # development | staging | production
VGS_LOG_LEVEL=INFO
# Draft catalogue entries are only usable when this is true, and ONLY in development/tests.
# The application refuses to start with true in staging or production.
ALLOW_DRAFT_CATALOG=false
VGS_PUBLIC_API_URL=                 # e.g. https://api.<domain>

# --- Database (Neon in dev: use the DIRECT connection, not the pooler) -----
DATABASE_URL=postgresql+psycopg://vgs:vgs@db:5432/vgs_dev
TEST_DATABASE_URL=postgresql+psycopg://vgs:vgs@db:5432/vgs_test

# --- Channel contract (core <-> gateway) -----------------------------------
CHANNEL_ADAPTER=whatsapp_baileys    # whatsapp_baileys | whatsapp_cloud | messenger | console
CHANNEL_ACCOUNT_ID=                 # the business number / page this instance serves
CORE_BASE_URL=http://127.0.0.1:8080
GATEWAY_BASE_URL=http://127.0.0.1:8081
CHANNEL_HMAC_SECRET=                # >= 32 random bytes, hex. Shared by core and gateway.
CHANNEL_HMAC_MAX_SKEW_SECONDS=300
REPLY_WINDOW_HOURS=24               # configurable, never infinite, also for Baileys in dev
BATCH_WINDOW_MS=3000                # wait for rapid messages before calling the LLM

# --- Gateway (Baileys, development only) -----------------------------------
GATEWAY_AUTH_STATE_KEY=             # key that encrypts the Baileys session stored in Postgres
GATEWAY_MIN_INTERVAL_MS=1500        # prudent starting values, NOT official limits
GATEWAY_MAX_PER_MINUTE=20

# --- Object storage (S3-compatible, e.g. Cloudflare R2) --------------------
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Application-level encryption of documents (envelope encryption) -------
MASTER_KEY_ID=v1
MASTER_KEY_B64=                     # 32 random bytes, base64. Generate: python -m vgs.crypto.keytool generate v1
MASTER_KEYS_RETIRED_JSON=           # during a rotation only: {"v1": "<base64>"}

# --- AI provider (set at step 3) -------------------------------------------
ANTHROPIC_API_KEY=
LLM_MODEL_CONVERSATION=
LLM_MODEL_LIGHT=
LLM_MONTHLY_BUDGET_USD=             # hard cap, awaiting the client's answer
LLM_BUDGET_ALERT_PCT=80

# --- Alerts to the team ----------------------------------------------------
ALERT_EMAIL_SMTP_URL=
ALERT_SMS_PROVIDER=

# --- Payments (step 5) -----------------------------------------------------
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Data lifecycle --------------------------------------------------------
RETENTION_DAYS_DOCUMENTS=
RETENTION_DAYS_MESSAGES=
